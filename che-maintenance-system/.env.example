# EMMS integration — copy to .env.local and adjust.
# mock = simulated EMMS (default, no connection). api = live EMMS through the 2GO integration gateway.
VITE_EMMS_MODE=mock

# Base URL of the integration gateway that fronts EMMS. The gateway holds the
# read-only EMMS service account (NFR-S05); never put EMMS credentials here —
# VITE_ variables are compiled into the browser bundle.
VITE_EMMS_BASE_URL=https://integration.example.2go.com.ph/emms/v1

# Request timeout and page size for work-order pulls.
VITE_EMMS_TIMEOUT_MS=15000
VITE_EMMS_PAGE_SIZE=500
